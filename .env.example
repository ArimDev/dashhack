# Resolve relative paths from the repository root. Railway: /data/dashhack.sqlite
NUXT_SQLITE_PATH=./.data/dashhack.sqlite
# Optional public Discord invite:
NUXT_PUBLIC_DISCORD_INVITE=
# Docker Compose's host port; the app listens on 1020 inside its container.
webPort=1020
# GitHub App (server-only). Complete all fields to enable Connect GitHub.
NUXT_GITHUB_APP_ID=
NUXT_GITHUB_APP_CLIENT_ID=
NUXT_GITHUB_APP_CLIENT_SECRET=
NUXT_GITHUB_APP_PRIVATE_KEY=
NUXT_GITHUB_APP_SLUG=
NUXT_GITHUB_APP_BASE_URL=http://localhost:5002

# Optional: X API recent-search access, server-only; social wall works without it
NUXT_X_BEARER_TOKEN=

# Optional: Captapi Instagram hashtag search, server-only
NUXT_CAPTAPI_API_KEY=

# Optional private reusable student repository links; random 32+ character server-only key.
# Clearing disables claims; rotating invalidates all old links.
NUXT_GITHUB_TEAM_INVITE_SECRET=
